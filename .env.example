# Connection string do Neon (Dashboard -> Connection Details -> Pooled connection)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segredo usado para assinar o cookie de sessão. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes
